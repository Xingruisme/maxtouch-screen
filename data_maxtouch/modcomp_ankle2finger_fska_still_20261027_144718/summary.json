 "modcomp_sha": "f7ac60ab572a",
 "dbpsk_rules": "nodes = top 3 by energy increase after START TX (v4 rule 1); y = sum of (x - OFF baseline) / OFF sigma over them; timing: carrier-on and carrier-off edges (first / last |y| > 10 lead rms, midpoint to the neighbouring sample) give the start and the clock (n_symbols bits apart, clipped to +-200 ppm as v4); bit k = 1 if y(last guarded sample of symbol k-1) * y(first guarded sample of symbol k) < 0, guard 2 ms as v4, no guarded sample -> any sample of the symbol, none -> decided 0",
 "fska_rules": {
  "nodes": "top 3 by scan-to-scan energy after the START prompt over before it",
  "baseline": "per node, running median of all scans over 0.5 s (tone deltas are symmetric about the baseline)",
  "feature": "v = sqrt(mean over the 3 nodes of ((x - baseline) / node rms after the prompt)^2), one value per scan",
  "guard_ms": 2.0,
  "scans_per_bit": "guarded scans (2 ms from each bit edge); none -> every scan inside the bit; none -> erasure (error)",
  "pilot": "16 preamble + 11 SFD bits of each frame (13 ones, 14 zeros)",
  "calibration": "u = v / frame scale (median v over the frame's pilot-1 scans); p1, p0 = Gaussian-kernel densities of u over all pilot-1 / pilot-0 scans of the run, bandwidth per symbol by Silverman's rule (0.9 min(sd, IQR/1.34) n^-1/5, at least 0.005), floor 1e-3",
  "decision": "bit 1 if the sum over its scans of log p1(u) / p0(u) > 0",
  "known_timing": "t_first + delay 0-25 ms (0.25 ms) x clock -200..+200 ppm (50 ppm), maximising the mean per-frame pilot correlation (Pearson r of per-bit mean v^2 vs the pilot bits)",
  "blind": "pilot correlation at every Tb/4 from the recording start (no t_first), greedy non-overlapping peaks with r >= 0.6, each refined over +-Tb/4 in Tb/16; a frame counts as found when its refined r >= 0.6 and its scale (median v of its pilot-1 scans) >= 5 x the median v of the transmitter-off lead; with >= 3 frames found, the frame most others agree with (within one bit of a whole number of frame periods) anchors a least-squares line start = a + b x frame number through the agreeing frames; disagreeing ones are dropped"
 },
